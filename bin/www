#!/usr/bin/env node

const http = require("http");
const app = require("../app");
const config = require("../config");
const logger = require("../lib/logger");
const db = require("../lib/db");

const server = http.createServer(app);

server.on("error", (error) => {
  if (error.code === "EADDRINUSE") {
    logger.fatal(`Port ${config.port} is already in use`);
    process.exit(1);
  }
  throw error;
});

server.listen(config.port, () => {
  logger.info(
    { embedding: config.embeddingProvider, chat: config.chatProvider },
    `Listening on http://localhost:${config.port}`,
  );
});

// Don't block startup on the database; /health reports if it's unreachable
db.ensureIndexes().catch((error) => {
  logger.warn({ err: error.message }, "Could not ensure MongoDB indexes");
});

async function shutdown(signal) {
  logger.info(`${signal} received, shutting down`);
  server.close();
  await db.closeDb();
  process.exit(0);
}

process.once("SIGINT", shutdown);
process.once("SIGTERM", shutdown);
