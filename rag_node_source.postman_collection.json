{
  "info": {
    "name": "RAG Node Source",
    "description": "Endpoints for the RAG Express app. Set `baseUrl` to where the server runs (default http://localhost:3000). `jobId` and `sessionId` are filled in automatically by the requests that return them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "description": "Checks MongoDB (and Ollama when a provider uses it). 200 when healthy, 503 when degraded."
      }
    },
    {
      "name": "Load Document",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.jobId) pm.collectionVariables.set(\"jobId\", body.jobId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/load-document",
        "description": "Starts a background job that parses ./docs/policy.pdf, embeds each line and replaces the contents of rag_doc.docs. Returns 202 with a jobId; 409 if a load is already running."
      }
    },
    {
      "name": "Job Status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/jobs/{{jobId}}",
        "description": "Progress ({done, total}) and the final result of a load job."
      }
    },
    {
      "name": "Test Embeddings",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/embeddings?text=ambulance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "embeddings"
          ],
          "query": [
            {
              "key": "text",
              "value": "ambulance"
            }
          ]
        },
        "description": "Returns the provider, model, dimensions and vector for `text`."
      }
    },
    {
      "name": "Conversation - New Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.sessionId) pm.collectionVariables.set(\"sessionId\", body.sessionId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/conversation",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Is ambulance cover included?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Starts a new session and answers using vector search. Returns {sessionId, answer, sources}; sessionId is saved to the collection variable."
      }
    },
    {
      "name": "Conversation - Existing Session",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/conversation",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"Can you explain that in more detail?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Continues the session created by the previous request."
      }
    }
  ]
}
