# MongoDB Atlas connection string (required)
DB=mongodb+srv://<user>:<password>@<cluster>/
# DB_NAME=rag_doc
# VECTOR_INDEX=vector_index

# gemini | ollama  (default: ollama)
EMBEDDING_PROVIDER=ollama
# gemini | ollama | ollama-cloud  (default: ollama)
CHAT_PROVIDER=ollama

# Required if either provider is gemini
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-flash-latest
# GEMINI_EMBED_MODEL=gemini-embedding-001

# OLLAMA_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Required if CHAT_PROVIDER=ollama-cloud
# OLLAMA_API_KEY=
# OLLAMA_CLOUD_CHAT_MODEL=gpt-oss:120b

# Must match numDimensions of the Atlas vector index
# EMBEDDING_DIMENSIONS=768
# Default: all pages for ollama, 2 for gemini
# MAX_PDF_PAGES=
# PDF_PATH=./docs/policy.pdf
# Parallel embedding calls while loading. Default: 4 for ollama, 1 for gemini
# INGEST_CONCURRENCY=

# Requests per minute per IP on /conversation (0 = off)
# RATE_LIMIT_PER_MINUTE=30
# EMBED_TIMEOUT_MS=30000
# CHAT_TIMEOUT_MS=120000

# development | production
# NODE_ENV=development
# trace | debug | info | warn | error  (debug also logs full prompts)
# LOG_LEVEL=info
